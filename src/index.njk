---
layout: base.njk
---

<section class="works-section" id="selected-works">
  <div class="works-grid">
    {% for work in collections.selectedWorks %}
      {% include "work-card.njk" %}
    {% endfor %}
  </div>
</section>

<section class="about-section" id="about">
  <div class="section-heading">
    <h2>About</h2>
  </div>

  <div class="about-grid">
    <p>
	Graphic designer and art director based in Reykjavík. Working across
	visual identities, books, exhibitions and print, with an interest in
	thoughtful concepts and considered visual communication.

	Educated at the Iceland University of the Arts and the Royal Danish
	Academy.
    </p>
    <p>
      Available for selected freelance collaborations in art direction,
      identity and print.
    </p>
  </div>
</section>

<section class="contact-section" id="contact">
  <div class="section-heading">
    <h2>Contact</h2>
  </div>

  <a class="big-link" href="mailto:{{ site.email }}">{{ site.email }}</a>
</section>
