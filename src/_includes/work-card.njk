<a class="work-card" href="{{ work.url | url }}">
  <div class="work-image-wrap">
    {% if work.data.video %}
      {% set animatedThumbnail = work.data.videoThumbnail == "animated" %}
      <video
        class="work-image"
        src="{{ work.data.video | url }}"
        {% if work.data.videoPoster or work.data.image %}poster="{{ (work.data.videoPoster or work.data.image) | url }}"{% endif %}
        {% if animatedThumbnail %}autoplay{% endif %}
        muted
        {% if animatedThumbnail %}loop{% endif %}
        playsinline
        preload="{% if animatedThumbnail %}metadata{% else %}none{% endif %}"
        aria-hidden="true"
      ></video>
    {% else %}
      <img
        class="work-image"
        src="{{ work.data.image | url }}"
        alt="{{ work.data.imageAlt or work.data.title }}"
        loading="lazy"
        width="600"
        height="400"
      >
    {% endif %}
  </div>

  <div class="work-meta">
    <div>
      <h2>{{ work.data.title }}</h2>
    </div>

    <div class="work-meta-right">
      {% if work.data.categories %}
        <p>{{ work.data.categories | join(" · ") }}</p>
      {% endif %}
    </div>
  </div>
</a>
