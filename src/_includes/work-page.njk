---
layout: base.njk
---

<article class="work-page">
  <header class="work-intro">
    <a class="back-link" href="{{ '/#selected-works' | url }}">← Selected Works</a>

    <div class="work-title-row">
      <div>
        <p class="eyebrow">{{ client }}</p>
        <h1>{{ title }}</h1>
      </div>

      <div class="work-facts">
        {% if year %}<span>{{ year }}</span>{% endif %}
        {% if category %}<span>{{ category }}</span>{% endif %}
      </div>
    </div>

    {% if intro %}
      <p class="work-description">{{ intro }}</p>
    {% endif %}
  </header>

  <div class="work-gallery">
    {% if gallery %}
      {% for image in gallery %}
        <figure class="gallery-item {% if loop.index == 1 %}gallery-item-large{% endif %}">
          <img src="{{ image.src | url }}" alt="{{ image.alt or title }}" loading="{% if loop.index == 1 %}eager{% else %}lazy{% endif %}">
          {% if image.caption %}
            <figcaption>{{ image.caption }}</figcaption>
          {% endif %}
        </figure>
      {% endfor %}
    {% else %}
      <figure class="gallery-item gallery-item-large">
        <img src="{{ image | url }}" alt="{{ imageAlt or title }}">
      </figure>
    {% endif %}
  </div>

  {% if body %}
    <div class="work-body">
      {{ body | safe }}
    </div>
  {% endif %}
</article>
