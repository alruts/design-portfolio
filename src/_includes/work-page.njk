---
layout: base.njk
---

<article class="work-page">
  <div class="work-intro">
    <div>
      <h1>{{ title }}</h1>
    </div>
    <div class="work-intro-right">
      {% if intro %}<p class="work-description">{{ intro }}</p>{% endif %}
      <div class="work-facts">
        {% if client %}<span>{{ client }}</span>{% endif %}
        {% if year %}<span>{{ year }}</span>{% endif %}
        {% if category %}<span>{{ category }}</span>{% endif %}
      </div>
    </div>
  </div>

  <div class="work-gallery">
    {% if gallery %}
      <figure class="gallery-hero">
        <img src="{{ gallery[0].src | url }}" alt="{{ gallery[0].alt or title }}" loading="eager">
      </figure>
      {% if gallery.length > 1 %}
        <div class="gallery-grid">
          {% for image in gallery %}
            {% if loop.index > 1 %}
              <figure class="gallery-item">
                <img src="{{ image.src | url }}" alt="{{ image.alt or title }}" loading="lazy">
                {% if image.caption %}<figcaption>{{ image.caption }}</figcaption>{% endif %}
              </figure>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    {% else %}
      <figure class="gallery-hero">
        <img src="{{ image | url }}" alt="{{ imageAlt or title }}" loading="eager">
      </figure>
    {% endif %}
  </div>

  {% if content %}
    <div class="work-body">{{ content | safe }}</div>
  {% endif %}
</article>

<section class="works-section" id="selected-works">
  <div class="section-heading">
    <h2>More works</h2>
  </div>
  <div class="works-grid">
    {% for work in collections.selectedWorks %}
      {% if work.url != page.url %}
        {% include "work-card.njk" %}
      {% endif %}
    {% endfor %}
  </div>
</section>

